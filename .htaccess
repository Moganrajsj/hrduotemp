<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to Laravel's public directory
    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^ - [F,L]

    # Route all requests into Laravel's public directory
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Deny access to sensitive files if mod_rewrite is unavailable
<FilesMatch "(^\.env|^\.git|composer\.(json|lock)|^artisan$|^phpunit\.xml$)">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes
